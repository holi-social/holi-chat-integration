{
  "name": "holi-ocis-integration",
  "version": "1.0.0",
  "main": "dist/index.js",
  "repository": "https://gitlab.holi.team/app/holi-ocis-integration.git",
  "scripts": {
    "build": "yarn clean && tsc && yarn copy-files",
    "test": "jest --collect-coverage",
    "start": "npx functions-framework --target=receiveEvent --signature-type=cloudevent",
    "prestart:dev": "yarn pg-migrations apply --directory src/db/migrations",
    "start:dev": "npx functions-framework --target=receiveEvent --signature-type=cloudevent --port=8088",
    "help": "holi-ocis-integration contains cloud functions to process events received from holis Google Cloud Pub/Sub containing events from the okuna_{development|production} topics. Follows https://cloud.google.com/functions/docs/running/function-frameworks.",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "clean:all": "yarn clean && rimraf node_modules",
    "copy-files": "copyfiles -u 1 src/**/*.json dist/"
  },
  "devDependencies": {
    "@databases/pg-migrations": "^5.0.2",
    "@google-cloud/functions-framework": "^3.1.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^16.11.10",
    "@types/winston": "^2.4.4",
    "copyfiles": "^2.4.1",
    "jest": "^29.5.0",
    "prettier": "2.8.7",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "4.5.2"
  },
  "dependencies": {
    "@databases/pg": "^5.4.1",
    "@databases/pg-schema-cli": "^4.3.1",
    "@databases/pg-typed": "^4.4.1",
    "axios": "^1.3.4",
    "https": "^1.0.0",
    "pg": "^8.4.0",
    "winston": "^3.8.2"
  }
}
